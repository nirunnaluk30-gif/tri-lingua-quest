rules_version = '2';
// TRI-LINGUA Quest — Cloud Firestore security rules (v2, 2026-11-13)
// Each student signs in with an ID; their Firebase email is  id_<ID>@id.trilingua.local
// and their player id in the game is  id_<ID>.  Admins are listed in /admins/{playerId}.
// v2: only real game logins count (exact email form + password sign-in), saves and admin
// records are tied to the sign-in account (auid), sign-up is enforced when the teacher closes it.
service cloud.firestore {
  match /databases/{database}/documents {

    // A real game login: ID + password, email exactly  id_<ID>@id.trilingua.local
    // (an account made elsewhere, e.g. id_teacher@another-domain, is NOT signed in here)
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('id_[a-z0-9_.-]{3,20}@id[.]trilingua[.]local')
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function me() { return request.auth.token.email.split('@')[0]; }
    function isMe(pid) { return signedIn() && me() == pid; }

    // admin = listed in /admins and (once claimed) the same sign-in account
    function adminPath() { return /databases/$(database)/documents/admins/$(me()); }
    function isAdmin() {
      return signedIn() && exists(adminPath())
        && (!('auid' in get(adminPath()).data) || get(adminPath()).data.auid == request.auth.uid);
    }

    // sign-up open? (teacher's switch in "Classes & sign-up"; open when never set)
    function regOpen() {
      let sp = /databases/$(database)/documents/settings/school;
      return !exists(sp) || get(sp).data.get('open', true) != false;
    }
    // a save belongs to the account that made it; '' = teacher unlocked it for a new password
    function boundToMe(data) { return !('auid' in data) || data.auid == '' || data.auid == request.auth.uid; }
    // the signed-in student owns this player id: their save, or a new one while sign-up is open
    // (returning students whose save was reset/gifted may come back even when sign-up is closed)
    function ownsPlayer(pid) {
      let pp = /databases/$(database)/documents/players/$(pid);
      return isMe(pid) && (exists(pp) ? boundToMe(get(pp).data)
        : (regOpen()
           || exists(/databases/$(database)/documents/adjust/$(pid))
           || exists(/databases/$(database)/documents/players/$(pid)/log/0)));
    }

    // who can manage the game
    match /admins/{pid} {
      allow read: if isMe(pid) || isAdmin();
      allow create, delete: if isAdmin();
      // an admin may tie their own record to their account once (adds only "auid")
      allow update: if isAdmin()
        || (isMe(pid) && !('auid' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['auid'])
            && request.resource.data.auid == request.auth.uid);
    }

    // game content (words, lessons, zones, items, ...) and site settings: everyone signed in reads, admins edit
    match /bundle/{col}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{doc}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /history/{doc}   { allow read: if signedIn(); allow write: if isAdmin(); }

    // each player's own save and play history (the save keeps the account binding)
    match /players/{pid} {
      allow read: if isAdmin() || ownsPlayer(pid);
      allow create, update: if isAdmin() || (ownsPlayer(pid) && request.resource.data.auid == request.auth.uid);
      allow delete: if isAdmin() || ownsPlayer(pid);
      match /{sub=**} { allow read, write: if isAdmin() || ownsPlayer(pid); }
    }

    // teacher gifts and corrections: the student reads, only admins write
    match /adjust/{pid} {
      allow read: if isAdmin() || ownsPlayer(pid);
      allow write: if isAdmin();
    }

    // anti-cheat checkpoints: admins only
    match /audit/{doc} { allow read, write: if isAdmin(); }

    // trading board and town: everyone signed in reads, each player writes only their own
    match /market/{pid} { allow read: if signedIn(); allow write: if isAdmin() || ownsPlayer(pid); }
    match /town/{pid}   { allow read: if signedIn(); allow write: if isAdmin() || isMe(pid); }

    // gem top-up requests: private to the student and admins
    match /topup/{pid} { allow read, write: if isAdmin() || ownsPlayer(pid); }

    // Chaos City boss: everyone signed in sees the hits; each player writes only their own, at most 10 answers
    match /raid/{rid}/hits/{pid} {
      allow read: if signedIn();
      allow write: if isAdmin() || (isMe(pid) && request.resource.data.n is int && request.resource.data.ok is int
                     && request.resource.data.n <= 10 && request.resource.data.ok >= 0 && request.resource.data.ok <= request.resource.data.n);
    }

    // anything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
